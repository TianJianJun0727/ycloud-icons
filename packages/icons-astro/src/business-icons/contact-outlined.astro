          <path d="M9.39355 16C9.39355 15.1513 9.75177 14.3374 10.3894 13.7372C11.027 13.1371 11.8918 12.8 12.7936 12.8C13.6953 12.8 14.5601 13.1371 15.1977 13.7372C15.8353 14.3374 16.1936 15.1513 16.1936 16" stroke="currentColor" stroke-width={strokeWidth ?? "1.5"} stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
    </g>
  </g>
</svg>
