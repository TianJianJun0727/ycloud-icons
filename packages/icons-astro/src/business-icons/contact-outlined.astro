  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  stroke-width={strokeWidth}
  width={width ?? size}
  height={height ?? size}
  role={alt ? 'img' : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : true}
  color={color}
  style={style}
  {...props}
>
  <g transform="translate(-3 -3) scale(1.25)">
    <g>
      <g>
        <g>
          <path d="M17.3077 4H8.69231C7.20539 4 6 5.19391 6 6.66667V17.3333C6 18.8061 7.20539 20 8.69231 20H17.3077C18.7946 20 20 18.8061 20 17.3333V6.66667C20 5.19391 18.7946 4 17.3077 4Z" stroke="currentColor" stroke-width={strokeWidth ?? "1.5"} stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4 9.02301H6" stroke="currentColor" stroke-width={strokeWidth ?? "1.5"} stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4 12H6" stroke="currentColor" stroke-width={strokeWidth ?? "1.5"} stroke-linecap="round" stroke-linejoin="round" />
