@font-face {
  font-family: "ycloud-business";
  src: url('ycloud-business.eot'); /* IE9*/
  src: url('ycloud-business.eot#iefix') format('embedded-opentype') /* IE6-IE8 */,
  url('ycloud-business.woff2') format('woff2'),
  url('ycloud-business.woff') format('woff'),
  url('ycloud-business.ttf') format('truetype'),
  url('ycloud-business.svg') format('svg');
}

[class^="business-icon-"], [class*=" business-icon-"] {
  font-family: 'ycloud-business' !important;font-size: inherit;
  font-style:normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}




.business-icon-botfilled::before { content: "\f032"; }
.business-icon-coming-soon::before { content: "\f048"; }
.business-icon-hub-spot::before { content: "\f064"; }
.business-icon-meta-filled::before { content: "\f072"; }
.business-icon-shopify::before { content: "\f09a"; }
.business-icon-trophy::before { content: "\f0ab"; }


$business-icon-botfilled = '\f032'
$business-icon-coming-soon = '\f048'
$business-icon-hub-spot = '\f064'
$business-icon-meta-filled = '\f072'
$business-icon-shopify = '\f09a'
$business-icon-trophy = '\f0ab'
